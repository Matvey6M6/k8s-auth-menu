{
    "name": "@mmmatvey122/k8s-auth-menu",
    "version": "1.0.0",
    "description": "Batch login to Kubernetes/OpenShift clusters from OpenLens",
    "renderer": "dist/renderer.js",
    "license": "MIT",
    "private": true,
    "files": [
        "dist/renderer.js",
        "README.md"
    ],
    "engines": {
        "lens": "^6.0.0"
    },
    "scripts": {
        "build": "webpack --mode=production",
        "dev": "webpack --mode=development --watch",
