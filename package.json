        "pack-extension": "npm run clean && npm run build && npm pack"
    },
    "devDependencies": {
        "@types/node": "^18.19.50",
        "@types/react": "^17.0.83",
        "ts-loader": "^9.5.1",
        "typescript": "^4.9.5",
        "webpack": "^5.95.0",
        "webpack-cli": "^5.1.4"
    }
}
